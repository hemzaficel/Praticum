<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Praticum" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Couleurs principales -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>

        <!-- Barres système assorties au fond de l'application -->
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:navigationBarColor">@color/screen_background</item>

        <!-- Icônes claires sur fond sombre -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:enforceNavigationBarContrast">false</item>

    </style>

</resources>