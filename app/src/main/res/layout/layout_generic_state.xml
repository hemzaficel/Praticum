<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/genericStateContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/screen_background"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/layoutGenericStateContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Indicateur visuel -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_menu_selected"
            android:foregroundGravity="center">

            <ProgressBar
                android:id="@+id/progressGenericState"
                style="?android:attr/progressBarStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ivGenericStateIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_warning"
                app:tint="@color/primary" />

        </FrameLayout>

        <!-- Titre -->
        <TextView
            android:id="@+id/tvGenericStateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Aucune donnée disponible"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvGenericStateMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Les informations apparaîtront ici lorsqu'elles seront disponibles."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <!-- Action principale -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenericStateAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Réessayer"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:visibility="gone"
            app:backgroundTint="@color/primary"
            app:cornerRadius="12dp" />

        <!-- Action secondaire facultative -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenericStateSecondary"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Retour"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>